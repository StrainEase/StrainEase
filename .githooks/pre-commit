#!/bin/sh
# Runs on `git commit`. Order matters: refresh the AI context snapshot
# first (so reviewers see the latest ground truth), then run lint-staged
# on the staged files only. Full-repo checks (tsc, prettier --check)
# live in pre-push.
set -eu

if [ "${AI_SKIP_HOOKS:-}" = "1" ]; then
  exit 0
fi

node scripts/ai-context.mjs --quiet
bunx --no-install lint-staged
