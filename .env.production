# Production / preview build env. Vite auto-loads this during
# `npm run build` and bakes the values into the static bundle via
# `import.meta.env.VITE_*`. Commit-friendly because every value is a
# Firebase client SDK identifier — these are public by design
# (Firebase security is enforced via Firestore Rules, not by hiding
# the API key). For extra defense, restrict the Web API Key in
# Firebase Console → Project Settings → General → "Web API Key" by
# HTTP referrer (*.strainease.ai, *.jc3.workers.dev) and/or API
# restrictions.

VITE_FIREBASE_API_KEY=AIzaSyCLPCkkqB_fgucLWGcZy4pEj2fNh0KDT8o
VITE_FIREBASE_AUTH_DOMAIN=strainfinder-84a9b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=strainfinder-84a9b
VITE_FIREBASE_STORAGE_BUCKET=strainfinder-84a9b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=89734321536
VITE_FIREBASE_APP_ID=1:89734321536:web:1636d8cfd4f7cf86e31d65
VITE_FIREBASE_MEASUREMENT_ID=G-3T72V4WJJM

# Google sign-in. Leave blank if you don't use Google sign-in —
# the app shows a clear error if it's needed and missing. If you
# do use it, set the Web client ID from Firebase Console →
# Authentication → Sign-in method → Google → "Web SDK configuration".
VITE_GOOGLE_CLIENT_ID=
