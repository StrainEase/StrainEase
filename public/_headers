/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/og-image.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=86400

/og-image.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400

# Vite bundles JS/CSS into /assets/[name]-[hash].{js,css} — the content hash
# makes the filename unique per build, so we can serve them as immutable
# for a year. Returning visitors skip the entire bundle download.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Same logic for /icon-* if we add small webp variants.
/icon-*.webp
  Cache-Control: public, max-age=31536000, immutable
