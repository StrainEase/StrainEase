# Template for local development. Copy this to `.env.local` (which
# is gitignored) and fill in real values for your own Firebase project.
# See `.env.production` for the values Cloudflare Workers Builds uses
# during `npm run build` for production + preview deployments.
#
# `npm run dev` (Vite dev server) loads `.env.local` automatically.
# `npm run build` (Cloudflare build) loads `.env.production` from
# the repo, NOT `.env.local`.

# Firebase Web SDK config. Get these from Firebase Console →
# Project Settings → General → "Your apps" → Web app → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Only used if you call getAnalytics() in code.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Web client ID for Google sign-in. From Firebase Console
# → Authentication → Sign-in method → Google → "Web SDK configuration".
VITE_GOOGLE_CLIENT_ID=
