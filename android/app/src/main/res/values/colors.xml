<?xml version="1.0" encoding="utf-8"?>
<!--
  StrainEase brand tokens. These mirror the iOS `Palette` so both
  surfaces share one set of color values. The full Material 3 color
  scheme is generated by `Theme.kt` from these primitives; the rest of
  the app should reference `MaterialTheme.colorScheme.*` rather than
  the raw palette, the same way SwiftUI screens reference `Palette.*`.
-->
<resources>
    <!-- Light tokens (iOS `Palette.light(...)`) -->
    <color name="palette_background_light">#F6F9F7</color>
    <color name="palette_foreground_light">#19251E</color>
    <color name="palette_card_light">#FFFFFF</color>
    <color name="palette_primary_light">#01603A</color>
    <color name="palette_on_primary_light">#F9FDFA</color>
