    <color name="palette_muted_fg_light">#57685E</color>
    <color name="palette_accent_light">#DDF3E5</color>
    <color name="palette_border_light">#DAE1DD</color>
    <color name="palette_ring_light">#4D916B</color>
    <color name="palette_destructive_light">#C7382E</color>
    <color name="palette_indica_light">#B87A29</color>
    <color name="palette_sativa_light">#2E75AD</color>
    <color name="palette_hybrid_light">#01603A</color>
    <color name="palette_glow_mint_light">#8CD1A8</color>
