<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The XML theme only paints the splash screen (the `windowSplashScreenBackground`
      and `windowSplashScreenAnimatedIcon`). The actual app theme lives
      in code (`StrainEaseTheme.kt`) so it can use the full Material 3
      dynamic color system and the same `Palette` tokens as the iOS
      client.
    -->
    <style name="Theme.StrainEase.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/palette_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.StrainEase</item>
    </style>

    <!--
      Debug-only splash: no animated icon (Compose isn't ready yet on
      a JIT-less emulator, which keeps the splash visible for 1+ min).
      Dismissal is instant — the branded icon shows inside the app
      content instead. The release theme keeps the animated icon.
    -->
    <style name="Theme.StrainEase.Splash.Debug" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/palette_background_light</item>
        <item name="postSplashScreenTheme">@style/Theme.StrainEase</item>
    </style>

    <style name="Theme.StrainEase" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
