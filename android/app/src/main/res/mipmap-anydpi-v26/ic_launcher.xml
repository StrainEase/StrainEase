<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8+). The foreground is the full brand
  tile from public/android-icon/light.png — a green gradient with
  the white leaf + caduceus artwork baked in. The inset wrapper
  applies 0% padding so the artwork fills the 108dp canvas
  edge-to-edge and the launcher can mask the result to whatever
  icon shape the user picked (squircle, circle, teardrop, etc.).

  The brand-green background is still painted underneath so the
  zoom-in animation and any anti-aliasing fringe match the
  launcher tile instead of leaking through to whatever the home
  screen wallpaper is.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/palette_primary_light" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground_inset" />
</adaptive-icon>