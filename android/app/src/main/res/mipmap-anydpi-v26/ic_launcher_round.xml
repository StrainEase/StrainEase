<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant of the adaptive icon. Identical composition to
  ic_launcher.xml — Android composites both layers the same way
  and applies the launcher-chosen shape mask on top, so the
  foreground artwork and brand-green background are reused
  verbatim. Some legacy launchers still ask for a `roundIcon`
  resource even when adaptive icons are in play, which is why
  this file exists alongside ic_launcher.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/palette_primary_light" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground_inset" />
</adaptive-icon>