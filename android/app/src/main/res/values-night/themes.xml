<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StrainWise.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/palette_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="postSplashScreenTheme">@style/Theme.StrainWise</item>
    </style>

    <style name="Theme.StrainWise" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
