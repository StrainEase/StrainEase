{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strainease",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Build-time environment variables. Cloudflare Workers Builds passes
  // these into the `npm run build` process so Vite's `import.meta.env.VITE_*`
  // sees them and bakes them into the static-asset bundle. Without this,
  // preview deployments build with empty `VITE_FIREBASE_*` values and the
  // Firebase-dependent paths silently fall through to the "not configured"
  // branch.
  //
  // Firebase client SDK values are public by design — Firebase security
  // is enforced server-side via Firestore Rules, not by hiding the API key.
  // If you want extra defense, restrict the Web API Key in the Firebase
  // Console → Project Settings → General → "Web API Key" by HTTP referrer
  // (*.strainease.ai, *.jc3.workers.dev) and/or API restrictions.
  "build": {
    "command": "npm run build",
    "cwd": "/",
    "vars": {
      "VITE_FIREBASE_API_KEY": "AIzaSyCLPCkkqB_fgucLWGcZy4pEj2fNh0KDT8o",
      "VITE_FIREBASE_AUTH_DOMAIN": "strainfinder-84a9b.firebaseapp.com",
      "VITE_FIREBASE_PROJECT_ID": "strainfinder-84a9b",
      "VITE_FIREBASE_STORAGE_BUCKET": "strainfinder-84a9b.firebasestorage.app",
      "VITE_FIREBASE_MESSAGING_SENDER_ID": "89734321536",
      "VITE_FIREBASE_APP_ID": "1:89734321536:web:1636d8cfd4f7cf86e31d65",
      "VITE_FIREBASE_MEASUREMENT_ID": "G-3T72V4WJJM"
    }
  }
}
