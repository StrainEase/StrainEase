rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client-side popular-strains cache. Public data — anyone may read.
    // Only the first signed-in client to see a stale cache writes a
    // fresh copy so everyone else benefits.
    match /clientCache/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Server-side strain cache — written only by the Cloud Function admin
    // SDK. Clients read directly for instant lookups; writes go through
    // the public/AI callables which hydrate from this cache.
    match /strainCache/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Server-side Reddit quote cache (PullPush + Arctic Shift + daily
    // refresh). Same shape as strainCache: admin-SDK-only, clients
    // route through the AI/public callables.
    match /redditQuoteCache/{key} {
      allow read, write: if false;
    }

    // Strain catalog cache: the full Leafly directory stored as lightweight previews.
    // Written by the warmStrainDirectory scheduled function (admin SDK only).
    // Read by the popularStrains + browseStrains callables; clients see the
    // callable output, not Firestore directly.
    match /strainCatalog/{docId} {
      allow read, write: if false;
    }

    // Saved strains + notes are private to each user.
    match /users/{uid}/savedStrains/{slug} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public notes are readable by everyone, written only by signed-in users.
    match /publicNotes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() < 2000;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // AI results written only by Cloud Functions (Admin SDK). Anyone may read
    // a result they have the id for — ids are unguessable UUIDs.
    match /researchResults/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/reliefLogs/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.strainName is string
        && request.resource.data.strainName.size() < 80
        && request.resource.data.fit in ['too-strong', 'just-right', 'too-weak']
        && request.resource.data.relief is number
        && request.resource.data.relief >= 1
        && request.resource.data.relief <= 5
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt > 0;
      allow update: if false;
    }

    // Private search history index for signed-in patients.
    match /users/{uid}/history/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind', 'title', 'createdAt'])
        && request.resource.data.kind in ['find', 'compare']
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200
        && request.resource.data.createdAt is number;
      allow update: if false;
    }

    // Saved ailments live on the user doc (same fields iOS already writes).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      function ailmentsPayload() {
        return request.resource.data.keys().hasAll(['ailments', 'ailmentsUpdatedAt'])
          && request.resource.data.ailments is list
          && request.resource.data.ailments.size() <= 16
          && request.resource.data.ailmentsUpdatedAt is number
          && request.resource.data.ailmentsUpdatedAt > 0;
      }

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ailments', 'ailmentsUpdatedAt'])
        && ailmentsPayload();

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ailments', 'ailmentsUpdatedAt'])
        && ailmentsPayload();

      allow delete: if false;
    }

    // Persistent medication list per user — private, list/add/remove only.
    match /users/{uid}/medications/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'addedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() < 80
        && request.resource.data.addedAt is number
        && request.resource.data.addedAt > 0;
      allow update: if false;
    }

    // Daily symptom check-ins: one document per day, keyed by `YYYY-MM-DD`
    // (the lib uses `todayKey()` to build the id). The four tracked metrics
    // (mood, sleep, pain, anxiety) are all 1–5 integer scales. A free-form
    // `note` is optional and capped at 1000 chars. Patients may update the
    // same day (revise) and delete (wipe a day).
    match /users/{uid}/checkIns/{dateId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      function checkInPayload() {
        return request.resource.data.keys().hasOnly([
          'date', 'mood', 'sleep', 'pain', 'anxiety', 'note', 'createdAt', 'updatedAt',
        ])
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 10
          && request.resource.data.mood is int
          && request.resource.data.mood >= 1
          && request.resource.data.mood <= 5
          && request.resource.data.sleep is int
          && request.resource.data.sleep >= 1
          && request.resource.data.sleep <= 5
          && request.resource.data.pain is int
          && request.resource.data.pain >= 1
          && request.resource.data.pain <= 5
          && request.resource.data.anxiety is int
          && request.resource.data.anxiety >= 1
          && request.resource.data.anxiety <= 5
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.createdAt is number
          && request.resource.data.createdAt > 0
          && request.resource.data.updatedAt is number
          && request.resource.data.updatedAt > 0;
      }

      allow create: if request.auth != null
        && request.auth.uid == uid
        && dateId.size() > 0
        && dateId.size() <= 10
        && checkInPayload();

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mood', 'sleep', 'pain', 'anxiety', 'note', 'updatedAt'])
        && checkInPayload();
    }

    // Age-verification audit log. Each user can write at most one doc per
    // region they've attested for. Server (admin SDK) is the source of truth
    // for the timestamps; client writes are rejected to keep users from
    // back-dating their own attestation.
    match /users/{uid}/ageVerification/{region} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Community strain reviews: anyone can read; signed-in users write their own.
    // One review per strain per user (upsert via reviewId = `${uid}_${strainSlug}`).
    // starRating is required (1-5); reviewText and consumptionForm are optional.
    match /strainReviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.strainSlug is string
        && request.resource.data.strainSlug.size() > 0
        && request.resource.data.strainSlug.size() < 200
        && request.resource.data.starRating is number
        && request.resource.data.starRating >= 1
        && request.resource.data.starRating <= 5
        && request.resource.data.reviewText.size() < 500
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt > 0
        && (
          request.resource.data.consumptionForm == null
          || request.resource.data.consumptionForm in ['flower', 'cart', 'edible', 'tincture']
        );
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['starRating', 'reviewText', 'consumptionForm', 'updatedAt'])
        && request.resource.data.starRating is number
        && request.resource.data.starRating >= 1
        && request.resource.data.starRating <= 5
        && request.resource.data.reviewText.size() < 500
        && (
          request.resource.data.consumptionForm == null
          || request.resource.data.consumptionForm in ['flower', 'cart', 'edible', 'tincture']
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Aggregated rating summary per strain. Written only by the Cloud Function
    // admin SDK (the submitStrainReview callable). Clients read freely.
    match /strainRatings/{strainSlug} {
      allow read: if true;
      allow write: if false;
    }

    // Reference library: curated terpene + cannabinoid records.
    // Public read (this is informational content, not user data);
    // admin-SDK-only writes via the seedReferenceLibrary callable.
    // Each document is a single record keyed by slug.
    match /terpeneLibrary/{slug} {
      allow read: if true;
      allow write: if false;
    }
    match /cannabinoidLibrary/{slug} {
      allow read: if true;
      allow write: if false;
    }
  }
}
